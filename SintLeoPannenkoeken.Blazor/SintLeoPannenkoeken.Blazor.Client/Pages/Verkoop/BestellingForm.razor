@using SintLeoPannenkoeken.Blazor.Client.Components
@using SintLeoPannenkoeken.Blazor.Client.Server
@using SintLeoPannenkoeken.Blazor.Client.Server.Contracts

<MudItem xs="12" sm="8">
    <MudTextField @bind-Value="Item.Naam"
                  T="string"
                  Label="Naam koper"
                  Required="true"
                  RequiredError="Naam koper is verplicht."
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  ShrinkLabel
                  @ref="_naamField" />
</MudItem>
<MudItem xs="12" sm="4">
    <MudTextField @bind-Value="Item.Telefoon" T="string" Label="Telefoon" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel />
</MudItem>

<MudItem xs="12" sm="2">
    <MudCheckBox T="bool" Value="@ZelfAfhalen" Label="Zelf afhalen" ValueChanged="@OnZelfAfhalenChanged" />
</MudItem>
<MudItem xs="12" sm="5">
    <StraatAutocomplete @bind-Value="Item.Straat"
                        Label="Straat"
                        Straten="@_straten"
                        Disabled="@ZelfAfhalen" />
</MudItem>
<MudItem xs="12" sm="2" Class="d-flex align-center">
    Code: <MudChip T="string">@($"{Item.Straat?.ZoneNaam} {Item.Straat?.Nummer}")</MudChip>
</MudItem>
<MudItem xs="12" sm="2">
    <MudTextField @bind-Value="Item.Nummer" T="string" Label="Nummer" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel
                  Disabled="@ZelfAfhalen" />
</MudItem>
<MudItem xs="12" sm="1">
    <MudTextField @bind-Value="Item.Bus" T="string" Label="Bus" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel
                  Disabled="@ZelfAfhalen" />
</MudItem>

<MudItem xs="12" sm="2">
    <MudNumericField @bind-Value="Item.AantalPakken" T="int" Label="Aantal pakken" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel Required="true" RequiredError="Het aantal pakken is verplicht" />
</MudItem>
<MudItem xs="12" sm="2">
    <MudCheckBox @bind-Value="Item.Betaald" T="bool" Label="Betaald" />
</MudItem>
<MudItem xs="12" sm="2">
    <MudCheckBox @bind-Value="Item.Geleverd" T="bool" Label="Geleverd" />
</MudItem>
<MudItem xs="12" sm="6">
    <MudTextField @bind-Value="Item.Opmerkingen" T="string" Label="Opmerkingen" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel />
</MudItem>

<MudItem xs="12">
    <LidAutocomplete @bind-Value="Item.Lid"
                     Label="Lid"
                     Leden="@_leden"
                     Required="true"
                     RequiredError="Het lid is verplicht." />
</MudItem>

@code {
    public bool ZelfAfhalen = false;

    private IList<LidDto> _leden = [];
    private IList<StraatDto> _straten = [];
    private MudTextField<string> _naamField = default!;

    [Inject]
    private IServerData _serverData { get; set; } = default!;

    [Parameter]
    public BestellingDto Item { get; set; } = new BestellingDto { Betaald = true };

    public async Task Reset()
    {
        Item = new BestellingDto { Betaald = true };
        ZelfAfhalen = false;
        StateHasChanged();
        await _naamField.FocusAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        ZelfAfhalen = Item?.Straat?.Id == 120;
        _straten = (await _serverData.GetStraten()).OrderBy(straat => straat.Naam).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _leden = (await _serverData.GetLeden()).OrderBy(lid => lid.Achternaam).ThenBy(lid => lid.Voornaam).ToList();
    }

    private void OnZelfAfhalenChanged(bool value)
    {
        ZelfAfhalen = value;
        if (value)
        {
            Item.Straat = _straten.Single(x => x.Id == 120);
            Item.Nummer = "";
            Item.Bus = "";
        }
    }
}
