@page "/verkoop/bestellingenimport"
@using SintLeoPannenkoeken.Blazor.Client.Components
@using SintLeoPannenkoeken.Blazor.Client.Server
@using SintLeoPannenkoeken.Blazor.Client.Auth
@using SintLeoPannenkoeken.Blazor.Client.Server.Contracts

<PageTitle>Bestellingen Importeren</PageTitle>

<MudStack Row="true" Breakpoint="Breakpoint.Xs">
    <h1>Bestellingen Importeren</h1>
    <ScoutsjaarSelect Value="_selectedScoutsjaarBegin" />
</MudStack>

<div class="mt-4">

    @if (_isScoutsjaarGearchiveerd)
    {
        <MudAlert Severity="Severity.Info">Er kunnen geen wijzigingen meer gebeuren voor dit scoutsjaar omdat het gearchiveerd is.</MudAlert>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.CloudDownload"
               Disabled="_isScoutsjaarGearchiveerd || _isLoading"
               OnClick="GetData"
               Class="mb-4">
        Data ophalen
    </MudButton>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-8">
            <MudProgressCircular Size="Size.Large" Indeterminate="true" />
        </MudStack>
    }
    else if (_importData == 0 && (_hangendeBestellingen == null || _hangendeBestellingen.Count == 0))
    {
        <MudAlert Severity="Severity.Info">Er is nog geen data opgehaald. Klik op de knop hierboven om de online bestellingen op te halen.</MudAlert>
    }
    else
    {
        @if (_importData > 0)
        {
            <MudAlert Severity="Severity.Success">Er werden @_importData bestellingen geïmporteerd.</MudAlert>
        }
        
        @if (_hangendeBestellingen != null && _hangendeBestellingen.Count > 0)
        {
            <MudAlert Severity="Severity.Warning">Er zijn @_hangendeBestellingen.Count bestellingen die handmatig moeten worden gematcht.</MudAlert>
            
            <h3>Hangende bestellingen (@_hangendeBestellingen.Count)</h3>
            
            <MudStack Row="true" Spacing="4" Class="mb-8 flex-wrap" Style="gap: 16px;">
                @foreach (var bestelling in _hangendeBestellingen)
                {
                    <MudCard Class="@($"pending-order-card pa-4 {GetCardClass(bestelling)}")" Style="width: 100%;" Elevation="5">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">#@bestelling.OnlineBestellingId @bestelling.Naam</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudTooltip Placement="Placement.Left">
                                    <ChildContent>
                                        <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                                    </ChildContent>
                                    <TooltipContent>
                                        <MudStack>
                                            <MudStack Row="true"><strong>Naam:</strong> @bestelling.Naam</MudStack>
                                            <MudStack Row="true"><strong>Telefoon:</strong> @bestelling.Telefoon</MudStack>
                                            <MudStack Row="true"><strong>Email:</strong> @bestelling.Email</MudStack>
                                            <MudStack Row="true"><strong>Aantal pakken:</strong> @bestelling.AantalPakken</MudStack>
                                            <MudStack Row="true"><strong>Straat:</strong> @bestelling.Straat</MudStack>
                                            <MudStack Row="true"><strong>Nummer:</strong> @bestelling.Nummer</MudStack>
                                            <MudStack Row="true"><strong>Bus:</strong> @bestelling.Bus</MudStack>
                                            <MudStack Row="true"><strong>Postcode:</strong> @bestelling.Postcode</MudStack>
                                            <MudStack Row="true"><strong>Gemeente:</strong> @bestelling.Gemeente</MudStack>
                                            <MudStack Row="true"><strong>Lid:</strong> @bestelling.Lid</MudStack>
                                            <MudStack Row="true"><strong>Tak:</strong> @bestelling.Tak</MudStack>
                                            <MudStack Row="true"><strong>Levering:</strong> @bestelling.Levering</MudStack>
                                            <MudStack Row="true"><strong>Betaald:</strong> @bestelling.Betaald</MudStack>
                                            <MudStack Row="true"><strong>Geleverd:</strong> @bestelling.Geleverd</MudStack>
                                            <MudStack Row="true"><strong>Opmerkingen:</strong> @bestelling.Opmerkingen</MudStack>
                                            <MudStack Row="true"><strong>Datum:</strong> @(bestelling.DatumAangemaakt?.ToString("dd/MM/yyyy") ?? "N/A")</MudStack>
                                        </MudStack>
                                    </TooltipContent>
                                </MudTooltip>
                            </CardHeaderActions>
                        </MudCardHeader>
                        
                        <MudCardContent>
                            <MudStack Spacing="4" Row="true">
                                <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2" Class="me-2">Ingevulde straat:</MudText>
                                    <MudText Typo="Typo.body2" Class="text-secondary">@bestelling.Straat, @bestelling.Postcode @bestelling.Gemeente</MudText>
                                </MudStack>
                                
                                <StraatAutocomplete Value="@bestelling.ProposedStraat"
                                                    ValueChanged="(s) => OnStraatSelected(bestelling, s)"
                                                    Label="Kies straat"
                                                    Straten="@_straten" />
                                
                                <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Class="mt-2">
                                    <MudText Typo="Typo.body2" Class="me-2">Ingevuld lid:</MudText>
                                    <MudText Typo="Typo.body2" Class="text-secondary">@bestelling.Lid (@bestelling.Tak)</MudText>
                                </MudStack>
                                
                                <LidAutocomplete Value="@bestelling.ProposedLid"
                                                 ValueChanged="(l) => OnLidSelected(bestelling, l)"
                                                 Label="Kies lid"
                                                 Leden="@_leden" />
                            </MudStack>
                            
                            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                           OnClick="() => SaveBestelling(bestelling)"
                                           Disabled="@(!CanSave(bestelling))">
                                    Opslaan
                                </MudButton>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        }
        
        @if (_importData == 0 && (_hangendeBestellingen == null || _hangendeBestellingen.Count == 0))
        {
            <MudAlert Severity="Severity.Info">Er zijn geen online bestellingen gevonden voor dit scoutsjaar.</MudAlert>
        }
    }

    @if (_errorMessage != null)
    {
        <MudAlert Severity="Severity.Error">Er is een fout opgetreden bij het ophalen van de data: @_errorMessage</MudAlert>
    }

</div>

@code {
    private IEnumerable<ScoutsjaarDto> _scoutsjaren = new List<ScoutsjaarDto>();
    private int _selectedScoutsjaarBegin;
    private bool _isScoutsjaarGearchiveerd = false;
    private int _importData = 0;
    private IList<PendingOnlineBestellingDto>? _hangendeBestellingen = null;
    private string? _errorMessage = null;
    private IList<StraatDto> _straten = new List<StraatDto>();
    private IList<LidDto> _leden = new List<LidDto>();
    private bool _isLoading = true;
    private int? _removingBestellingId = null;

    [Inject]
    public IServerData ServerData { get; set; } = default!;

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    public CurrentScoutsjaarQuerystringParameterProvider CurrentScoutsjaarQuerystringParameterProvider { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var uriBuilder = new UriBuilder(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uriBuilder.Query);
        var scoutsjaarParameter = query["scoutsjaar"];
        if (scoutsjaarParameter != null)
        {
            _selectedScoutsjaarBegin = int.Parse(scoutsjaarParameter);
        }

        _scoutsjaren = await ServerData.GetScoutsjaren();
        var selectedScoutsjaar = await CurrentScoutsjaarQuerystringParameterProvider.GetCurrentScoutsjaar();
        if (selectedScoutsjaar == null)
        {
            selectedScoutsjaar = _scoutsjaren.FirstOrDefault();
            NavigationManager.NavigateTo($"{NavigationManager.Uri}?scoutsjaar={selectedScoutsjaar!.Begin}");
        }

        _selectedScoutsjaarBegin = selectedScoutsjaar.Begin;
        _isScoutsjaarGearchiveerd = selectedScoutsjaar.Status == ScoutsjaarStatusDto.Gearchiveerd;

        // Load straten and leden first
        try
        {
            _straten = (await ServerData.GetStraten()).OrderBy(s => s.Naam).ToList();
            _leden = (await ServerData.GetLeden()).OrderBy(l => l.Achternaam).ThenBy(l => l.Voornaam).ToList();
        }
        catch (Exception e)
        {
            _errorMessage = "Fout bij laden straten/leden: " + e.Message;
            _isLoading = false;
            return;
        }

        // Load hangende bestellingen on page load
        try
        {
            _hangendeBestellingen = await ServerData.GetHangendeBestellingen(_selectedScoutsjaarBegin);

            // Sync ProposedStraatId/ProposedLidId to ProposedStraat/ProposedLid for the UI
            // This ensures pre-selection happens before first render
            if (_hangendeBestellingen != null)
            {
                foreach (var bestelling in _hangendeBestellingen)
                {
                    if (bestelling.ProposedStraatId.HasValue)
                    {
                        bestelling.ProposedStraat = _straten.FirstOrDefault(s => s.Id == bestelling.ProposedStraatId.Value);
                    }
                    if (bestelling.ProposedLidId.HasValue)
                    {
                        bestelling.ProposedLid = _leden.FirstOrDefault(l => l.Id == bestelling.ProposedLidId.Value);
                    }
                }
            }
        }
        catch (Exception e)
        {
            _errorMessage = "Fout bij laden hangende bestellingen: " + e.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
    }

    private void OnStraatSelected(PendingOnlineBestellingDto bestelling, StraatDto? straat)
    {
        bestelling.ProposedStraat = straat;
        bestelling.ProposedStraatId = straat?.Id;
    }

    private void OnLidSelected(PendingOnlineBestellingDto bestelling, LidDto? lid)
    {
        bestelling.ProposedLid = lid;
        bestelling.ProposedLidId = lid?.Id;
    }

    private string GetCardClass(PendingOnlineBestellingDto bestelling)
    {
        if (_removingBestellingId == bestelling.Id)
        {
            return "pending-order-card-removing";
        }

        return "";
    }

    private bool CanSave(PendingOnlineBestellingDto bestelling)
    {
        return bestelling.ProposedStraatId.HasValue && bestelling.ProposedLidId.HasValue;
    }

    private async Task SaveBestelling(PendingOnlineBestellingDto bestelling)
    {
        if (!CanSave(bestelling))
        {
            return;
        }

        try
        {
            await ServerData.SaveHangendeBestelling(bestelling.Id, bestelling.ProposedStraatId.Value, bestelling.ProposedLidId.Value, _selectedScoutsjaarBegin);
            
            // Trigger animation by setting the removing ID
            _removingBestellingId = bestelling.Id;
            StateHasChanged();
            
            // Wait for animation to complete (300ms) then remove the card
            await Task.Delay(300);
            
            // Remove from the list
            if (_hangendeBestellingen != null)
            {
                var bestellingToRemove = _hangendeBestellingen.FirstOrDefault(b => b.Id == bestelling.Id);
                if (bestellingToRemove != null)
                {
                    _hangendeBestellingen.Remove(bestellingToRemove);
                    _removingBestellingId = null;
                    StateHasChanged();
                }
            }
        }
        catch (Exception e)
        {
            _removingBestellingId = null;
            _errorMessage = "Fout bij opslaan: " + e.Message;
            StateHasChanged();
        }
    }

    private async Task GetData()
    {
        _errorMessage = null;
        _isLoading = true;
        StateHasChanged();
        try
        {
            _importData = await ServerData.ImportOnlineBestellingen(_selectedScoutsjaarBegin);
            // Reload hangende bestellingen after import
            _hangendeBestellingen = await ServerData.GetHangendeBestellingen(_selectedScoutsjaarBegin);
        }
        catch (Exception e)
        {
            _errorMessage = e.Message;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
