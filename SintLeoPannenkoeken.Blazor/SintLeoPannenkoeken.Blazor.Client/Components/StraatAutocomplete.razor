@using SintLeoPannenkoeken.Blazor.Client.Server
@using SintLeoPannenkoeken.Blazor.Client.Server.Contracts

<MudAutocomplete Value="@Value"
                 ValueChanged="@ValueChanged"
                 SearchFunc="@SearchStraten"
                 ToStringFunc="@_straatConverter"
                 Variant="Variant.Outlined"
                 Label="@Label"
                 Margin="Margin.Dense"
                 MaxItems=100
                 Clearable="true"
                 CoerceText="true"
                 ResetValueOnEmptyText="true"
                 SelectValueOnTab="true"
                 Disabled="@Disabled" />

@code {
    private IList<StraatDto> _straten = [];

    [Inject]
    private IServerData _serverData { get; set; } = default!;

    [Parameter]
    public StraatDto? Value { get; set; }

    [Parameter]
    public EventCallback<StraatDto?> ValueChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public Func<string?, CancellationToken, Task<IEnumerable<StraatDto?>>?>? SearchFunc { get; set; }

    private async Task<IEnumerable<StraatDto?>?> SearchStraten(string input, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            return _straten;
        }

        return _straten.Where(x => x.Naam.Contains(input, StringComparison.InvariantCultureIgnoreCase));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var straten = await _serverData.GetStraten();
        _straten = straten.OrderBy(straat => straat.Naam).ToList();
    }

    private Func<StraatDto?, string> _straatConverter = straat =>
    {
        if (straat == null)
        {
            return "";
        }

        return $"{straat.Naam} ({straat.Gemeente})";
    };
}