@using SintLeoPannenkoeken.Blazor.Client.Server
@using SintLeoPannenkoeken.Blazor.Client.Server.Contracts

<MudAutocomplete Value="@Value"
                 ValueChanged="@ValueChanged"
                 SearchFunc="@SearchLeden"
                 ToStringFunc="@_lidConverter"
                 Variant="Variant.Outlined"
                 Label="@Label"
                 Margin="Margin.Dense"
                 MaxItems=100
                 Clearable="true"
                 CoerceText="true"
                 ResetValueOnEmptyText="true"
                 SelectValueOnTab="true"
                 Disabled="@Disabled"
                 Required="@Required"
                 RequiredError="@RequiredError" />

@code {

    [Inject]
    private IServerData _serverData { get; set; } = default!;

    [Parameter]
    public LidDto? Value { get; set; }

    [Parameter]
    public EventCallback<LidDto?> ValueChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string RequiredError { get; set; } = "";

    [Parameter]
    public Func<string?, CancellationToken, Task<IEnumerable<LidDto?>>?>? SearchFunc { get; set; }

    [Parameter]
    public IList<LidDto?> Leden { get; set; } = new List<LidDto?>();

    private async Task<IEnumerable<LidDto?>?> SearchLeden(string input, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            return Leden;
        }

        return Leden.Where(x =>
            x.Achternaam.Contains(input, StringComparison.InvariantCultureIgnoreCase)
            || x.Voornaam.Contains(input, StringComparison.InvariantCultureIgnoreCase));
    }

    private Func<LidDto?, string> _lidConverter = lid =>
    {
        if (lid == null)
        {
            return "";
        }

        return $"{lid.Achternaam} {lid.Voornaam} ({lid.TakNaam})";
    };
}
